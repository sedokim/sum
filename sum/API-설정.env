# 섬으로 API 키 통합 설정 (서버 전용 — 공유하거나 업로드하지 마세요)
# = 오른쪽에 키를 붙여 넣고 저장하세요. 따옴표 없이 입력해도 됩니다.
# 비어 있으면 기존 .env 설정을 사용하므로 현재 연결은 유지됩니다.
# 공공데이터 API 공통 키 (일반 인증키 Decoding 권장)
PUBLIC_DATA_SERVICE_KEY=

# 아래 개별 키를 입력하면 해당 API에서 공통 키보다 우선 사용합니다.
# 관광정보: https://www.data.go.kr/data/15101578/openapi.do
TOUR_API_KEY=TeIPTl70ecN3JGgfLtlT1H2zF7X4B9xvkRQBrOKxsilCafyKkNuSqO4t0JhUHiJXnhu%2BgGIru1obBhwJSN9vCQ%3D%3D
# 배편 시간표: https://www.data.go.kr/data/15142302/openapi.do
